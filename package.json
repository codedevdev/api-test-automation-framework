{
  "name": "api-test-automation-framework",
  "version": "1.0.0",
  "description": "REST API test automation framework for Restful Booker and Fake REST API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:contract": "playwright test --grep @contract",
    "test:e2e": "playwright test --grep @e2e",
    "test:all": "playwright test",
    "test:booker": "playwright test --project=restful-booker",
    "test:fake-api": "playwright test --project=fake-rest-api",
    "test:ci": "playwright test --grep \"@smoke|@contract\"",
    "newman:booker": "newman run postman/restful-booker.postman_collection.json -e postman/restful-booker.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export postman/newman/report-booker.html",
    "newman:fake-api": "newman run postman/fake-rest-api.postman_collection.json -e postman/fake-rest-api.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export postman/newman/report-fake-api.html",
    "newman:smoke": "npm run newman:booker && npm run newman:fake-api",
    "healthcheck": "tsx scripts/health-check.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "quality:check": "npm run typecheck && npm run lint && npm run format:check",
    "allure:generate": "allure generate ./allure-results --clean --single-file -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm api-tests",
    "docker:down": "docker compose down -v",
    "prepare": "husky"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "typescript",
    "newman",
    "postman",
    "allure",
    "qa-automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
