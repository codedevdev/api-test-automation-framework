{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "idBook", "firstName", "lastName"],
    "additionalProperties": true,
    "properties": {
      "id": { "type": "integer" },
      "idBook": { "type": "integer" },
      "firstName": { "type": ["string", "null"] },
      "lastName": { "type": ["string", "null"] }
    }
  }
}
